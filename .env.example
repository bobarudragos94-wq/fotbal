# Turso / libSQL
# For local dev you can use a local file: TURSO_DATABASE_URL="file:./local.db"
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# OAuth (optional — the buttons only show if the matching pair is set)
# Google: https://console.cloud.google.com → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com → app → Facebook Login → Settings
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Optional: force the redirect base URL (otherwise derived from the request host).
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Seed super admin credentials (used by `npm run db:seed`)
# Defaults are set to your account; override here if you want different ones.
SEED_SUPERADMIN_EMAIL="bobarudragos94@gmail.com"
SEED_SUPERADMIN_PASSWORD="noobsaibot"
SEED_SUPERADMIN_NICKNAME="Dragos"
